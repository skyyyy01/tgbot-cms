# ============================================================
# TelegramTRX 环境变量配置示例
# ============================================================
# 用法：复制本文件为 .env 并填入真实值，.env 已被 .gitignore 排除。
#
# 注意：Spring Boot 不会自动加载 .env 文件，请选择以下任一方式注入：
#   1. 启动前 source：set -a && source .env && set +a && java -jar xxx.jar
#   2. systemd 服务：在 unit 文件中使用 EnvironmentFile=/path/to/.env
#   3. Docker：docker run --env-file .env ...
#   4. IDE：在运行配置的 Environment variables 中逐项填写
# ============================================================

# ---------- 数据库（必填，生产环境未设置会导致启动失败）----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trx
DB_USERNAME=trx
DB_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=2
# 未设置密码的 Redis 留空即可；生产环境强烈建议设置
REDIS_PASSWORD=

# ---------- 文件上传路径 ----------
# dev 环境默认 ./uploadPath，pro 环境默认 /www/wwwroot/bot
PROFILE_PATH=

# ---------- Shiro RememberMe 加密密钥 ----------
# 生成方式（Java）：Base64.encodeToString(CipherUtils.generateNewKey(128, "AES").getEncoded())
# 留空则每次启动生成随机密钥（会导致已签发的 RememberMe Cookie 失效）
SHIRO_CIPHER_KEY=

# ---------- Druid 监控台 ----------
# 监控台会暴露全部 SQL 执行记录，生产环境默认关闭（pro 配置中 enabled 默认 false）
DRUID_STAT_ENABLED=false
DRUID_ALLOW_IP=127.0.0.1
DRUID_USERNAME=admin
DRUID_PASSWORD=

# ============================================================
# 以下为运行时业务配置，不走环境变量，需登录后台在【系统管理 - 参数设置】中填写
# 此处仅作清单说明，方便部署时逐项核对：
#
#   online.api.url    链上记录查询 API（TronScan 接口，需填入自己的收款地址）
#   api.auth.token    对外支付接口的认证 token，请自行生成高强度随机串
#   create.order.api  上游支付网关的创建订单接口地址
#   notify.url        支付结果异步回调地址
#
# Telegram Bot Token 在【机器人管理 - 机器人列表】中录入，同样不入库到本仓库。
# ============================================================
